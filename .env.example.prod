# PostHog production-ish self-hosted .env template.
#
# Usage:
#   1. Copy this file to .env:        cp .env.example.prod .env
#   2. Replace every CHANGE_ME_* value with a real value.
#   3. Run:                           bin/setup-prod
#
# Secrets generation:
#   POSTHOG_SECRET:       openssl rand -hex 32
#   ENCRYPTION_SALT_KEYS: openssl rand -hex 16
#

# ---------- Compose tooling (read by docker compose itself) ----------

# Project name -- prefixes container names, networks, volumes.
# Without this, compose uses the working dir name (e.g. "vibes_posthogfoss").
COMPOSE_PROJECT_NAME=posthog

# Default compose file -- lets you run `docker compose ps` without -f flag.
COMPOSE_FILE=docker-compose.prod.yml

# ---------- Required ----------

# Public hostname (no protocol, no trailing slash).
# Used for SITE_URL, Caddy CADDY_HOST, livestream URLs.
DOMAIN=CHANGE_ME_your.domain.tld

# Django secret key. 64 hex chars recommended.
POSTHOG_SECRET=CHANGE_ME_run_openssl_rand_hex_32

# Symmetric key used for encrypting OAuth tokens, plugin configs, etc.
# 32 hex chars. Rotating this invalidates existing encrypted data.
ENCRYPTION_SALT_KEYS=CHANGE_ME_run_openssl_rand_hex_16

# ---------- Service credentials ----------
#
# These swap the well-known defaults baked into base.yml / users.xml /
# dev-services.env. The defaults are not exposed publicly (MinIO is bound
# to 127.0.0.1, Postgres + ClickHouse only on the docker bridge), but anyone
# with SSH or `docker exec` access to the host can dump data using them.
#
# Cannot be live-rotated without coordinated ALTER USER + restart cycles
# across ~15 services. Set on a fresh install before first `bin/setup-prod`.
#
# Generate with:  openssl rand -hex 24
#

# Postgres password for the `posthog` user. Used by Django, Temporal, Node
# ingestion services, Rust services (feature-flags, property-defs, cyclotron,
# cymbal). Overrides `posthog` default in dev-services.env / base.yml.
POSTHOG_DB_PASSWORD=CHANGE_ME_postgres_openssl_rand_hex_24

# MinIO root password for object storage (session recordings, exports,
# error-tracking blobs). Overrides `object_storage_root_password` default.
OBJECT_STORAGE_PASSWORD=CHANGE_ME_minio_openssl_rand_hex_24

# ClickHouse `default` user password. Set on the user via the users.d.prod/
# overlay (read at CH startup via from_env). Overrides empty password default.
# Note: only the `default` user is rotated -- `api`/`apppass` users from
# users.xml are unused by prod services and are left as-is.
CLICKHOUSE_PASSWORD=CHANGE_ME_clickhouse_openssl_rand_hex_24

# ---------- Optional ----------

# Caddy TLS block. Leave empty to use Caddy's automatic Let's Encrypt
# (requires DOMAIN to resolve to this host on ports 80/443). Override
# only if you need a custom TLS config (e.g. internal CA, DNS-01, etc.).
TLS_BLOCK=

# Set to true to disable PostHog's own telemetry capture about your instance.
OPT_OUT_CAPTURE=true

# Container name for SeaweedFS (session replay storage). Override if you
# run multiple instances on the same host.
SEAWEEDFS_DOCKER_NAME=seaweedfs-main

# Optional registry prefix for the postgres image. Useful when pulling
# from a mirror. Empty means use Docker Hub.
DOCKER_REGISTRY_PREFIX=

# ---------- Image versions ----------

# ClickHouse server image. Pin to a specific tag for reproducible deploys.
# Bump after testing on staging. Default in base.yml is 26.3.9.8.
CLICKHOUSE_SERVER_IMAGE=clickhouse/clickhouse-server:26.3.9.8

# ---------- Retention / TTL ----------

# Kafka log retention enforced by kafka-init at cluster level (overrides the
# `--mode dev-container` default which silently ignores broker-level retention).
# Acts as a recovery window: if a consumer (plugin-server, ClickHouse Kafka
# engine) dies for longer than this, in-flight messages are dropped. In normal
# operation messages are consumed within seconds. 6 h covers overnight outages
# on a single-host box with auto-restart. Lower (1 h) saves disk; higher
# (24 h) gives more recovery slack at the cost of disk.
KAFKA_LOG_RETENTION_MS=21600000         # 6 hours
KAFKA_LOG_SEGMENT_SIZE=134217728        # 128 MB

# ClickHouse system_log retention. Controls how long query_log, trace_log,
# metric_log, part_log, asynchronous_metric_log, error_log persist. These
# tables can grow into hundreds of GB without a TTL.
CLICKHOUSE_SYSTEM_LOG_TTL_DAYS=7

# PostHog hog-function logs (sharded_log_entries) retention. Upstream default
# is 90 days (LOG_ENTRIES_TTL_DAYS=90 in posthog/clickhouse/log_entries.py).
# Hog functions (transformations like GeoIP, custom destinations) emit log
# rows per invocation; on busy installs this can reach multi-GB of mostly-
# debug data. 14 days is enough for "yesterday's hog function broke" debugging.
# Re-applied on every `bin/setup-prod` run (idempotent ALTER, self-heals if a
# PostHog migration ever resets it).
POSTHOG_LOG_ENTRIES_TTL_DAYS=14

# PostHog query log archive (sharded_query_log_archive) retention. Upstream
# has NO default TTL — the table copies system.query_log rows for the debug
# UI and grows unbounded. Each PostHog dashboard view generates several CH
# queries, so on busy installs this accumulates into GBs over time. 30 days
# covers the realistic "why was that query slow" debugging window.
POSTHOG_QUERY_LOG_ARCHIVE_TTL_DAYS=30

# Note: self-hosted PostHog defaults newly-created teams to 5 YEARS of session
# replay retention (hardcoded in posthog/models/team/team.py), which lets
# SeaweedFS replay blobs grow to TBs over time on a single-host install.
# After signup, change this per-project in: Settings → Replay → Recording
# retention. Valid options: 30 Days, 90 Days, 1 Year, 5 Years.

# ---------- Postgres tuning ----------
#
# Postgres image defaults are sized for embedded use. The `db` cgroup is
# capped at 4 GB in docker-compose.prod.yml (with 5 GB swap headroom) so
# bursty work_mem allocations from concurrent sorts/hashes don't OOM-kill
# PG. Read by the `command:` override on the `db` service.
#
# Worst case = shared_buffers + (work_mem × max_connections) +
#              (maintenance_work_mem × autovacuum_workers) + per-backend overhead
#            = 1 GB + (16 MB × 200) + (256 MB × 3) + ~500 MB
#            ≈ 5.5 GB
# The cgroup cap (4 GB) + memswap (5 GB) covers this with swap absorbing
# the transient work_mem spike. To shrink the PG footprint, lower
# POSTGRES_MAX_CONNECTIONS to 120 or POSTGRES_WORK_MEM to 8MB.
#
# shared_buffers       - memory PG itself owns for cached pages. 25-40% of
#                        the cgroup cap is the standard recommendation.
# effective_cache_size - hint to the planner about realistic OS page cache
#                        size. Not allocated, just a planner constant.
# work_mem             - per-sort/hash-join scratch. Each query can use
#                        multiple work_mem allocations.
# maintenance_work_mem - VACUUM, CREATE INDEX, ALTER TABLE allocations.
# max_connections      - upper bound on concurrent connections. Worker
#                        celery + Django web + Node ingestion services can
#                        each open ~30 connections under load.

POSTGRES_SHARED_BUFFERS=1GB
POSTGRES_EFFECTIVE_CACHE_SIZE=3GB
POSTGRES_WORK_MEM=16MB
POSTGRES_MAINTENANCE_WORK_MEM=256MB
POSTGRES_MAX_CONNECTIONS=200

# Write-throughput tuning. Big wins for high-volume event ingestion at the
# cost of crash-recovery semantics. Read alongside the comment block on the
# `db` service in docker-compose.prod.yml.
#
# synchronous_commit=off
#   3-5x write throughput on bursty workloads. Postgres replies "committed"
#   to the client before fsync completes — on a kernel/power crash you lose
#   the last few seconds of unflushed transactions (typically <100ms but up
#   to wal_writer_delay = 200ms by default). For analytics this is fine
#   because events are also in Kafka with 6 h retention; on recovery you can
#   re-consume what was lost. Set to `on` if you handle billing or any data
#   you can't re-derive.
POSTGRES_SYNCHRONOUS_COMMIT=off

# max_wal_size + checkpoint_timeout
#   Default (1GB / 5min) triggers checkpoints every few minutes under load,
#   each one stalling writers while dirty pages flush. 4GB / 15min stretches
#   the interval to 15-30 minutes — much smoother I/O. Costs disk: WAL can
#   grow to ~max_wal_size between checkpoints (released afterward).
POSTGRES_MAX_WAL_SIZE=4GB
POSTGRES_CHECKPOINT_TIMEOUT=15min

# autovacuum tuning for UPDATE-heavy tables. PostHog's posthog_person and
# posthog_persondistinctid get UPSERTed on every event for known users.
# Default scale_factor=0.2 means autovacuum waits until 20% of the table is
# dead tuples — at high event rates this is too late and queries slow down.
# 0.05 keeps hot tables lean; combined with naptime=20s autovacuum scans
# more often. Trade-off: more I/O. Acceptable on local NVMe.
POSTGRES_AUTOVACUUM_SCALE_FACTOR=0.05
POSTGRES_AUTOVACUUM_NAPTIME=20s

# ---------- Kafka partitioning ----------
#
# events_plugin_ingestion + events_plugin_ingestion_overflow partition count.
# Set in kafka-init at first run. Changing this later does NOT shrink existing
# topics (Kafka can only grow partitions), and re-partitioning breaks per-key
# ordering for in-flight events — set this once and leave alone.
#
# Sizing:
#   ingestion-general replicas = 2  -> 3 partitions (2 active + 1 standby)
#   ingestion-general replicas = 4  -> 5 or 6 partitions
#   ingestion-general replicas = N  -> N+1 partitions (always 1 spare for rebalance)
#
# Higher partition counts cost ~15-30 MB RAM per partition on the broker
# (Redpanda) and one file descriptor per partition × topic. Don't go above
# 8 unless you scale ingestion-general past 6 replicas.
KAFKA_INGESTION_PARTITIONS=3
