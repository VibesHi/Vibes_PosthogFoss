# Vibes_PosthogFoss production .env template.
#
# Bootstrap on a fresh host:
#   cp .env.example.prod .env
#   $EDITOR .env             # fill in CHANGE_ME_ values + DOMAIN
#   bin/setup-prod
#
# bin/setup-prod warns if .env is missing any key listed in this file
# (schema-drift detection -- catches "I git pull'd, forgot to merge new vars").
#
# Override any default by adding the key to .env (or `echo KEY=value >> .env`).

# ============================================================================
# Compose tooling -- read by `docker compose` itself, not by any service.
# Without these, plain `docker compose ps` from the repo root falls back to
# the working-directory name (e.g. "vibes_posthogfoss") and the default
# docker-compose.yml (doesn't exist here). Keep them set.
# ============================================================================

COMPOSE_PROJECT_NAME=posthog
COMPOSE_FILE=docker-compose.prod.yml

# ============================================================================
# Required -- replace CHANGE_ME_ with real values before bin/setup-prod runs.
# ============================================================================

# Public-facing domain. Caddy uses this for TLS cert provisioning.
DOMAIN=CHANGE_ME_your.domain.tld

# Django SECRET_KEY (mapped via docker-compose.prod.yml). Generate fresh:
#   openssl rand -hex 32          # 64 hex chars
POSTHOG_SECRET=CHANGE_ME_openssl_rand_hex_32

# Symmetric key for encrypting OAuth tokens, plugin configs, etc.
# Used as Fernet key input via base64.urlsafe_b64encode(x.encode()) in
# posthog/helpers/encrypted_fields.py — Fernet REQUIRES exactly 32 raw bytes,
# so this string must be exactly 32 chars. `hex 32` (64 chars) crashes Django
# at boot with "Fernet key must be 32 url-safe base64-encoded bytes".
# Generate fresh:
#   openssl rand -hex 16          # 32 hex chars  ← correct
ENCRYPTION_SALT_KEYS=CHANGE_ME_openssl_rand_hex_16

# Database / object storage / ClickHouse passwords.
# Generate each separately: openssl rand -hex 24
POSTHOG_DB_PASSWORD=CHANGE_ME_openssl_rand_hex_24
OBJECT_STORAGE_PASSWORD=CHANGE_ME_openssl_rand_hex_24
CLICKHOUSE_PASSWORD=CHANGE_ME_openssl_rand_hex_24

# ============================================================================
# Caddy / TLS
#
# CADDY_HOST is referenced inside docker-compose.base.yml's CADDYFILE: env
# value as ${CADDY_HOST:-http://localhost:8000}. Compose substitutes that at
# YAML parse time using the host shell + .env -- NOT the container's
# environment: block, which arrives too late. So CADDY_HOST MUST be set in
# .env or Caddy boots with the localhost fallback and never gets a TLS cert.
#
# .env does NOT expand ${DOMAIN} -- substitute the domain literally below.
# Quotes are required because the value contains commas and spaces; the
# `set -a; source .env` step in bin/setup-prod would otherwise tokenize it.
# docker-compose strips the outer quotes when reading .env, so the substituted
# YAML value stays correct.
# ============================================================================

# Caddy public host spec. Format: "<your.domain.tld>, http://, https://"
# Caddy provisions Let's Encrypt for the first hostname; http://+https://
# entries make Caddy listen on both 80 and 443 and auto-redirect HTTP->HTTPS.
CADDY_HOST="CHANGE_ME_your.domain.tld, http://, https://"

# Optional Caddy TLS directives. Empty = auto Let's Encrypt (default).
# Self-signed:     CADDY_TLS_BLOCK="tls /etc/caddy/cert.pem /etc/caddy/key.pem"
# LE staging CA:   CADDY_TLS_BLOCK="acme_ca https://acme-staging-v02.api.letsencrypt.org/directory"
CADDY_TLS_BLOCK=

# ============================================================================
# Multi-org / FOSS unlock
# ============================================================================

# Allow creating new organizations + projects. The fork's synthetic license
# advertises every AvailableFeature, so this only affects the
# `get_can_create_org()` gate. Default 'true' for self-hosted.
MULTI_ORG_ENABLED=true

# Tag emitted in posthoganalytics events. Distinguishes this fork from
# upstream cloud / hobby in any analytics sent to PostHog HQ.
DEPLOYMENT=vibes-foss

# ============================================================================
# Frontend feature flags (force-enabled at the appContext level)
# ============================================================================

# Comma-separated list of feature flag KEYS (not names) to force-enable in the
# frontend regardless of the PostHog feature-flag system. Upstream-supported
# mechanism (see `posthog/settings/feature_flags.py:9` -- "Used mostly by the
# hobby install to have some feature flags enabled by default"). Wired via
# `posthog/utils.py:440` into `appContext.persisted_feature_flags`. For
# non-cloud installs this is the ONLY source of feature flag values, so flags
# NOT listed here are off across the UI.
#
# Useful flags for self-hosted FOSS:
#   web-analytics-for-mobile      -> Switch WebAnalytics graphs/Paths from
#                                    $pageview to $screen events. Required for
#                                    mobile-only installs (otherwise Unique
#                                    Visitors graph + Paths tile stay empty).
#   calendar-heatmap-insight      -> Standalone Active Hours insight type.
#   web-experiments               -> Visual experiments (no-code A/B testing).
#   improved-cookieless-mode      -> Better cookieless tracking accuracy.
#   surveys-actions               -> Trigger surveys from posthog actions.
#
# More: see `frontend/src/lib/constants.tsx` `FEATURE_FLAGS = {...}`. Anything
# tagged `#team-billing`, `#team-growth`, billing/signup are cloud-only and
# pointless to enable on FOSS.
PERSISTED_FEATURE_FLAGS=web-analytics-for-mobile

# ============================================================================
# Query performance -- person properties on events
# ============================================================================

# Forces every team's `person_on_events_mode` to PERSON_ID_OVERRIDE_PROPERTIES_ON_EVENTS,
# which reads the person_properties JSON column already stamped on each event
# at ingest time. Without this override, posthog/models/team/team.py falls
# through to PERSON_ID_OVERRIDE_PROPERTIES_JOINED on self-hosted (the cloud
# feature-flag path is dead on FOSS), which JOINs events x person x
# person_distinct_id_overrides at query time. WebAnalytics, Trends, Retention,
# Funnels all become 5-30x slower without this. Caveat: events captured
# before this is on may have stale/empty person_properties; if you flip it
# mid-deployment, recent breakdowns may differ from older ones.
PERSON_ON_EVENTS_V2_OVERRIDE=True

# ============================================================================
# Throughput tuning -- ingestion path (mobile SDK -> /capture/ -> Kafka -> CH)
# ============================================================================

# Kafka partition count for events_plugin_ingestion + _overflow topics.
# Bound by ingestion-general replica count (deploy.replicas in compose).
# Default 6 = 4 active consumers + 2 standby for rebalance. Raise to 8-12
# if you scale ingestion-general above 4 replicas.
KAFKA_INGESTION_PARTITIONS=6

# Kafka log retention. Kafka here is a buffer between rust capture and
# Node consumers; healthy consumers drain in seconds. 6h covers overnight
# outages on auto-restart. Lower (1h) saves disk, higher (24h) gives more
# recovery slack.
# 21600000 ms = 6h. 86400000 ms = 24h.
KAFKA_LOG_RETENTION_MS=21600000
KAFKA_LOG_SEGMENT_SIZE=134217728

# Per-partition disk size cap (bytes). Hard ceiling against runaway
# producers / consumer outages. 20 GiB is comfortably above 6h time-
# retention at normal RPS so time-based deletion always wins under
# steady load. Bump for sustained >5k RPS or longer outage tolerance.
# 21474836480 = 20 GiB. 10737418240 = 10 GiB. 53687091200 = 50 GiB.
KAFKA_RETENTION_BYTES=21474836480

# ============================================================================
# Throughput tuning -- Django path (dashboard UI, /decide, /api/* CRUD)
# ============================================================================

# Web prefork app processes (sync Django, blocks on I/O). Each loads full
# Django + dagster heap (~1.2GB resident). Sized for self-hosted teams:
#   1 = lean (saves 1.2GB RAM, ~10-20 RPS Django ceiling, 1 user at a time)
#   2 = balanced (default, ~20-40 RPS, fine for 5-10 users)
#   4 = upstream default (~40-80 RPS, fine for 20+ users)
# Mobile SDK event ingestion does NOT touch web -- it goes through rust
# capture. This setting only affects dashboard UX.
NGINX_UNIT_APP_PROCESSES=1

# Celery prefork pool size for periodic + async tasks (person merges,
# feature flag computation, scheduled reports). Each prefork worker holds
# a full Django heap (~1GB resident). 1=lean, 2=balanced.
WEB_CONCURRENCY=1

# Recycle each Celery prefork worker after N tasks to release accumulated
# heap (Django ORM caches, infi.clickhouse_orm metadata, dagster leaks).
# Without this, RSS grows to mem_limit and OOMs after hours of uptime.
CELERY_MAX_TASKS_PER_CHILD=200

# ============================================================================
# Postgres tuning -- persistent metadata (teams, persons, dashboards)
# ============================================================================

# Connection pool ceiling. PostHog opens ~150 conns across all services at
# steady state; 200 leaves 50 headroom for ad-hoc psql + admin tasks.
# If you raise ingestion-general replicas above 4, also raise this (each
# replica opens ~30 conns at peak).
POSTGRES_MAX_CONNECTIONS=200

# Postgres own buffer pool. 25% of cgroup RAM is the standard guideline.
# Bump if you also bump x-mem-postgres in compose.
POSTGRES_SHARED_BUFFERS=1GB

# Planner hint for OS page cache size; not allocated. Realistic ~3GB out
# of the 4GB cgroup with 1GB shared_buffers above.
POSTGRES_EFFECTIVE_CACHE_SIZE=3GB

# Per-sort/hash-join scratch. Multiple per query (one per sort + hash).
# Worst case: 16MB × max_connections (200) × 2 = 6.4GB if every backend
# does a complex join simultaneously. Keep low.
POSTGRES_WORK_MEM=16MB

# autovacuum/REINDEX scratch. 256MB × 3 autovacuum workers = 768MB worst.
POSTGRES_MAINTENANCE_WORK_MEM=256MB

# Bursty write throughput. `off` = 3-5x faster on writes, may lose last
# few seconds of unflushed transactions on power loss. Acceptable for
# analytics (events can be re-derived from Kafka). NOT for billing data.
POSTGRES_SYNCHRONOUS_COMMIT=off

# WAL checkpoint tuning. Larger max_wal_size + longer timeout = smoother
# I/O at the cost of more disk used during checkpoints.
POSTGRES_MAX_WAL_SIZE=4GB
POSTGRES_CHECKPOINT_TIMEOUT=15min

# autovacuum on hot tables (posthog_person, posthog_persondistinctid).
# 0.05 = vacuum kicks in at 5% dead tuples (default 0.2). 20s naptime
# (default 60s) checks more often. Both keep lookup latency stable.
POSTGRES_AUTOVACUUM_SCALE_FACTOR=0.05
POSTGRES_AUTOVACUUM_NAPTIME=20s

# ============================================================================
# Image / runtime pins -- recommended on prod for reproducibility.
# ============================================================================

# Pin ClickHouse server image (auto-updates can break compatibility on minor
# bumps -- 26.x has had breaking changes in materialized views / system table
# schemas). Bump intentionally after testing on staging.
CLICKHOUSE_SERVER_IMAGE=clickhouse/clickhouse-server:26.3.9.8

# Opt out of PostHog's own telemetry (sends usage stats to posthog.com if
# false). Self-hosted FOSS deploys typically want this true.
OPT_OUT_CAPTURE=true

# SeaweedFS container name (replay storage). Override only if you run
# multiple stacks on the same host.
SEAWEEDFS_DOCKER_NAME=seaweedfs-main

# Registry prefix for the postgres image (mirror pulls). Empty = Docker Hub.
DOCKER_REGISTRY_PREFIX=

# ============================================================================
# Memory cap overrides -- only set explicitly here if `docker stats` shows a
# service consistently above 80% util on its current cap. See
# docker-compose.prod.yml for cap aliases (x-mem-clickhouse, x-mem-django).
# ============================================================================

# (none uncommented by default -- override service-level mem_limit in
# docker-compose.prod.yml directly when needed)

# ============================================================================
# Runtime TTLs applied by bin/setup-prod (idempotent ALTER TABLE on each run)
# ============================================================================

# Hog-function logs: per-invocation rows from transformations (GeoIP, custom
# destinations) and HogFlow steps. Upstream LOG_ENTRIES_TTL_DAYS=90 default
# is overkill for a self-hosted "yesterday's hog function broke" debug window.
POSTHOG_LOG_ENTRIES_TTL_DAYS=14

# Query log archive: copy of system.query_log for the debug UI. Upstream has
# NO TTL -- the table grows unbounded. 30d covers realistic "why was that
# query slow" investigation.
POSTHOG_QUERY_LOG_ARCHIVE_TTL_DAYS=30

# Note: ClickHouse system_log retention is hardcoded 7d in
# docker/clickhouse/config.d.prod/system_log_ttl.xml -- CH cannot interpolate
# env vars into <ttl>. Edit the XML if you need a different value.

# ============================================================================
# Compose profiles -- enabled services beyond the always-on core.
#
# This template enables `backup` and `events-export` BY DEFAULT because every
# self-hosted prod deploy needs both:
#   * `backup`        -> daily/weekly off-host disaster recovery (Postgres
#                        dumps + ClickHouse partitions to GCS).
#   * `events-export` -> daily Mixpanel-shape JSONL.gz archive of
#                        posthog.sharded_events to a SEPARATE GCS bucket,
#                        forever-retained.
#
# Other profiles (opt-in -- comment in only when needed):
#   * `cdp` -> cyclotron-janitor (HogHooks, destinations like Slack/BigQuery,
#             HogFlow workflows). Enable when you configure outbound
#             destinations in the PostHog UI. Inbound webhooks (RevenueCat,
#             Adapty, Stripe -> /capture/) do NOT need this.
#
# To run a strictly minimal stack with NO backups + NO events archive:
#   1. Comment out the COMPOSE_PROFILES line below.
#   2. Comment out every uncommented GCS_* / EVENTS_EXPORT_GCS_* line below.
#   3. (re-)run bin/setup-prod.
#
# Always-on (no profile gate, since most PostHog deploys eventually want it):
#   * hypercache-server (web SDK /array/* + Surveys /surveys/*).
#     Stop manually if you really only run iOS:
#       docker compose stop hypercache-server
#       docker compose rm -f hypercache-server
# ============================================================================

COMPOSE_PROFILES=backup,events-export

# ============================================================================
# Backups (off-host) -- consumed by the `backup` profile.
#
# Streams Postgres dumps + ClickHouse partitions to a Google Cloud Storage
# bucket on a daily/weekly/monthly cron. See README.prod.md "## Backups"
# for: bucket creation, HMAC key generation, lifecycle policy apply, restore
# runbook, and key rotation procedure.
#
# Setup checklist:
#   1. Create a GCS bucket (single-region, dual-region for higher durability).
#   2. Cloud Console -> Storage -> Settings -> Interoperability -> Create
#      access key for service account. Grant SA roles/storage.objectAdmin
#      on the bucket.
#   3. Fill in the three GCS_* values below (replacing CHANGE_ME placeholders).
#   4. bin/setup-prod (or `docker compose up -d --build backup`).
#   5. Apply lifecycle ONCE: see README.prod.md.
# ============================================================================

# Bucket URI WITH gs:// prefix. Operator-specific.
GCS_BUCKET=CHANGE_ME_gs://your-posthog-backups

# HMAC interop credentials. NOT a service-account JSON file -- HMAC keys are
# the S3-compatible auth path that both `aws-cli` (PG dump uploads) and
# ClickHouse `BACKUP TO S3()` consume. Generate in Cloud Console under
# Storage > Settings > Interoperability tab.
GCS_HMAC_KEY=CHANGE_ME_GOOG1...
GCS_HMAC_SECRET=CHANGE_ME_secret_from_console

# Region hint for `aws s3` -- "auto" works for any GCS bucket location.
# Override only if you hit signature-mismatch errors (rare).
# GCS_REGION=auto

# ============================================================================
# Events export (off-host, "forever" archive) -- consumed by the
# `events-export` profile.
#
# Daily JSONL.gz of posthog.sharded_events to a SEPARATE GCS bucket, one file
# per (team, day), Mixpanel-shape so re-import via batch-import-worker works
# unchanged. Different concern from Backups above:
#
#   Backups       -> disaster recovery, ZIP'd CH BACKUP TO S3() artifacts,
#                    aged-out per lifecycle.json, restore-into-CH only.
#   Events export -> analytical archive, plain JSONL.gz, forever retention,
#                    consumable from any tool that reads gzip.
#
# Use a SEPARATE bucket and a SEPARATE HMAC pair (not GCS_* above) so a
# leaked key only blasts one bucket. See:
#   - README.prod.md "## Events export"
#   - docker/posthog-events-export/README.md
#   - ee/scripts/posthog_events_export/README.md
#
# Setup checklist:
#   1. Create a NEW GCS bucket. Set its default storage class to Coldline
#      (every uploaded object is born Coldline -> cheapest forever-retention).
#      Do NOT apply any Lifecycle Delete rule on it.
#   2. Cloud Console -> Storage -> Settings -> Interoperability -> Create
#      access key for a NEW service account (do NOT reuse the backup SA).
#      Grant that SA roles/storage.objectAdmin on the new bucket only.
#   3. Fill in the three EVENTS_EXPORT_GCS_* values below.
#   4. docker compose --profile events-export up -d --build posthog-events-export
# ============================================================================

# Bucket URI WITH gs:// prefix. Fork-canonical default.
EVENTS_EXPORT_GCS_BUCKET=gs://vibes-analytics-events

# Dedicated HMAC pair for the analytics bucket. Different SA from the
# backup pair. Generate in Cloud Console under
# Storage > Settings > Interoperability tab.
EVENTS_EXPORT_GCS_HMAC_KEY=CHANGE_ME_GOOG1...
EVENTS_EXPORT_GCS_HMAC_SECRET=CHANGE_ME_secret_from_console

# Region hint for s3fs -- "auto" works for any GCS bucket location.
# EVENTS_EXPORT_GCS_REGION=auto
