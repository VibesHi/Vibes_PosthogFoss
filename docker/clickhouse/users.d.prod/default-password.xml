<?xml version="1.0"?>
<!--
  Production overlay: sets a password on the `default` ClickHouse user.

  base.yml ships docker/clickhouse/users.xml with an empty default password —
  fine for a single-host bridge network where you trust everyone with shell
  access, NOT fine if you grant SSH/docker access to others or split CH off-box.

  CLICKHOUSE_PASSWORD is read from the clickhouse server container's env
  (passed in via prod.yml), at server startup. ClickHouse expands `from_env`
  attributes when parsing config — see docker/clickhouse/config.d/default.xml
  for other examples of the same pattern (kafka_broker_list).

  `replace="replace"` on <default> tells CH to swap the entire user definition
  from base users.xml rather than merge, so the empty <password></password>
  there is fully overridden.

  All other services that talk to CH must also set CLICKHOUSE_PASSWORD in
  their environment — see prod.yml for the full list.
-->
<clickhouse>
    <users>
        <default replace="replace">
            <password from_env="CLICKHOUSE_PASSWORD" />
            <networks>
                <ip>::/0</ip>
            </networks>
            <profile>default</profile>
            <quota>default</quota>
            <access_management>1</access_management>
            <named_collection_control>1</named_collection_control>
            <show_named_collections>1</show_named_collections>
            <show_named_collections_secrets>1</show_named_collections_secrets>
        </default>
    </users>
</clickhouse>
