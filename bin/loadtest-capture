#!/usr/bin/env bash
#
# bin/loadtest-capture -- exercise the /capture endpoint with synthetic events.
#
# Wraps vegeta with PostHog-specific defaults: payload format, cleanup query,
# token sourcing from .env. Auto-installs vegeta on apt-based hosts.
#
# Usage:
#   bin/loadtest-capture                          # default ramp: 100/500/1k/5k
#   bin/loadtest-capture --rate 1000              # constant 1000 req/s for 30s
#   bin/loadtest-capture --rate 1000 --duration 5m
#   bin/loadtest-capture --token phc_xxx          # override token (default: read from DB or arg)
#   bin/loadtest-capture --domain custom.tld      # override target host
#   bin/loadtest-capture --cleanup                # delete loadtest events from CH and exit
#
# Side effects:
#   - Writes events with event="loadtest_ping" to your project. Run --cleanup
#     when done to remove them from posthog.sharded_events.
#   - Does NOT clean up associated person records, persondistinctid rows, or
#     replay blobs. The fake distinct_id is "loadtest_user" — easy to grep.
#
# Why not k6: k6 is more polished but requires JS test files. For
# fixed-payload ramp testing vegeta is one binary and three flags.
#
# Why not the Rust capture's built-in benchmark: there isn't one. The
# closest thing is `cargo bench` in rust/capture but that benchmarks the
# in-process handler, not the deployed Kafka path.
#

set -euo pipefail

readonly C_BLUE=$'\033[1;34m'
readonly C_YELLOW=$'\033[1;33m'
readonly C_RED=$'\033[1;31m'
readonly C_GREEN=$'\033[1;32m'
readonly C_RESET=$'\033[0m'

log()  { printf '%s[loadtest]%s %s\n' "$C_BLUE"   "$C_RESET" "$*"; }
warn() { printf '%s[loadtest]%s %s\n' "$C_YELLOW" "$C_RESET" "$*" >&2; }
die()  { printf '%s[loadtest]%s %s\n' "$C_RED"    "$C_RESET" "$*" >&2; exit 1; }
ok()   { printf '%s[loadtest]%s %s\n' "$C_GREEN"  "$C_RESET" "$*"; }

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$REPO_ROOT"

SUDO=""
[ "$(id -u)" -eq 0 ] || SUDO="sudo"

# ----- Args -----
MODE="ramp"          # ramp | constant | cleanup
RATE=0               # constant mode
DURATION="30s"
TOKEN=""
TARGET_DOMAIN=""

while [ $# -gt 0 ]; do
    case "$1" in
        --rate)     MODE="constant"; RATE="$2"; shift 2 ;;
        --duration) DURATION="$2"; shift 2 ;;
        --token)    TOKEN="$2"; shift 2 ;;
        --domain)   TARGET_DOMAIN="$2"; shift 2 ;;
        --cleanup)  MODE="cleanup"; shift ;;
        -h|--help)
            awk '/^set -euo pipefail/{exit} /^#/{sub(/^# ?/,""); print}' "$0"
            exit 0
            ;;
        *) die "Unknown arg: $1 (try -h)" ;;
    esac
done

# ----- Sourcing -----
[ -f .env ] || die ".env not found. Run from repo root, after bin/setup-prod."

# Source only the keys we need. Avoid `set -a; source .env` here because
# some users have shell-substitution-unsafe values in .env (multi-line, etc.)
DOMAIN_FROM_ENV=$(grep '^DOMAIN=' .env | head -n1 | cut -d= -f2- | tr -d '"' || true)
DOMAIN="${TARGET_DOMAIN:-$DOMAIN_FROM_ENV}"
[ -n "$DOMAIN" ] || die "DOMAIN not set in .env and --domain not given."

CH_PASSWORD=$(grep '^CLICKHOUSE_PASSWORD=' .env | head -n1 | cut -d= -f2- | tr -d '"' || true)

# Token: arg > env var > look up in DB.
if [ -z "$TOKEN" ]; then
    if [ -n "${POSTHOG_PROJECT_TOKEN:-}" ]; then
        TOKEN="$POSTHOG_PROJECT_TOKEN"
    else
        log "No --token given; reading first team's api_token from Postgres"
        TOKEN=$($SUDO docker compose exec -T db psql -U posthog -d posthog -At \
            -c "SELECT api_token FROM posthog_team ORDER BY id LIMIT 1" 2>/dev/null \
            | tr -d '\r\n' || true)
        [ -n "$TOKEN" ] || die "Could not read token from DB. Pass --token phc_..."
    fi
fi

# Sanity-check token format.
case "$TOKEN" in
    phc_*) : ;;
    *) warn "Token doesn't start with 'phc_'. Continuing anyway." ;;
esac

# ----- Cleanup mode -----
# Full scrub: ClickHouse events + Postgres taxonomy/person rows. Without the
# Postgres cleanup, `loadtest_ping` permanently pollutes the event picker UI
# and `loadtest_marker` shows up in property filters across the whole org.
#
# Defense in depth: every WHERE clause filters on BOTH the loadtest event
# name AND the loadtest_marker (or distinct_id='loadtest_user'). If a real
# user happens to emit `loadtest_ping`, we don't nuke their data.
if [ "$MODE" = "cleanup" ]; then
    [ -n "$CH_PASSWORD" ] || die "CLICKHOUSE_PASSWORD not in .env, cannot clean up."

    # 1. ClickHouse: events table mutation (async).
    log "Deleting loadtest events from posthog.sharded_events"
    $SUDO docker compose exec -T clickhouse clickhouse-client \
        --password="$CH_PASSWORD" \
        --query "ALTER TABLE posthog.sharded_events DELETE
                 WHERE event = 'loadtest_ping'
                   AND JSONExtractBool(properties, 'loadtest_marker') = 1" \
        || warn "CH events delete failed (continuing)"

    # 2. ClickHouse: person_distinct_id_overrides (synthetic distinct_id only).
    # `loadtest_user` is the hardcoded distinct_id from the request body,
    # so any row keyed on it is ours. Filter explicit to avoid wider blast.
    log "Deleting loadtest distinct_id overrides from posthog.person_distinct_id_overrides"
    $SUDO docker compose exec -T clickhouse clickhouse-client \
        --password="$CH_PASSWORD" \
        --query "ALTER TABLE posthog.person_distinct_id_overrides DELETE
                 WHERE distinct_id = 'loadtest_user'" \
        2>/dev/null || true   # table may not exist on older CH schemas

    # 3. Postgres: person row + distinct_id mapping + UI taxonomy entries.
    # Wrapped in a single transaction; rollback on error so a partial state
    # doesn't leave half-cleaned references.
    log "Cleaning Postgres (person, persondistinctid, eventdefinition, propertydefinition)"
    $SUDO docker compose exec -T db psql -U posthog -d posthog -v ON_ERROR_STOP=1 <<'SQL' \
        || warn "Postgres cleanup failed (continuing -- check manually)"
BEGIN;
-- distinct_id mapping for the synthetic loadtest user
DELETE FROM posthog_persondistinctid WHERE distinct_id = 'loadtest_user';
-- person row left orphaned by the delete above
DELETE FROM posthog_person
    WHERE id NOT IN (SELECT person_id FROM posthog_persondistinctid)
      AND properties->>'$lib' = 'loadtest-capture';
-- event picker pollution: 'loadtest_ping' shouldn't appear in autocomplete
DELETE FROM posthog_eventdefinition WHERE name = 'loadtest_ping';
-- property filter pollution: 'loadtest_marker' shouldn't appear either.
-- '$lib' is a real property name, so we only nuke our specific value via the
-- definition's volume_30_day proxy: leave $lib alone, it's used by all SDKs.
DELETE FROM posthog_propertydefinition WHERE name = 'loadtest_marker';
COMMIT;
SQL

    log "ALTER ... DELETE is async. Watch the mutation drain:"
    log "  docker compose exec clickhouse clickhouse-client --password=\"\$CLICKHOUSE_PASSWORD\" \\"
    log "    --database posthog \\"
    log "    --query \"SELECT table, mutation_id, is_done, parts_to_do FROM system.mutations WHERE NOT is_done\""
    log ""
    log "Verify CH events count drops to 0:"
    log "  docker compose exec clickhouse clickhouse-client --password=\"\$CLICKHOUSE_PASSWORD\" \\"
    log "    --database posthog --query \"SELECT count() FROM events WHERE event='loadtest_ping'\""
    ok "Cleanup queued (CH async; Postgres synchronous)"
    exit 0
fi

# ----- vegeta install (best-effort) -----
# vegeta isn't in Ubuntu's main apt repos (only Debian sid). Try package
# managers first, then fall back to GitHub release binary. Pinned version
# avoids "latest" resolving to a future breaking release.
install_vegeta_binary() {
    local version="12.12.0"
    local arch
    case "$(uname -m)" in
        x86_64)   arch="amd64" ;;
        aarch64)  arch="arm64" ;;
        arm64)    arch="arm64" ;;
        *) die "Unsupported arch: $(uname -m)" ;;
    esac
    local os
    case "$(uname -s)" in
        Linux)  os="linux" ;;
        Darwin) os="darwin" ;;
        *) die "Unsupported OS: $(uname -s)" ;;
    esac
    local url="https://github.com/tsenart/vegeta/releases/download/v${version}/vegeta_${version}_${os}_${arch}.tar.gz"
    log "Installing vegeta v${version} (${os}/${arch}) from GitHub releases"
    local tmpdir
    tmpdir=$(mktemp -d)
    curl -fsSL "$url" -o "$tmpdir/vegeta.tar.gz" \
        || die "Download failed: $url"
    tar -xzf "$tmpdir/vegeta.tar.gz" -C "$tmpdir" vegeta \
        || die "Extract failed"
    $SUDO install -m 0755 "$tmpdir/vegeta" /usr/local/bin/vegeta \
        || die "Install to /usr/local/bin failed"
    rm -rf "$tmpdir"
    log "vegeta installed: $(vegeta -version 2>&1 | head -1)"
}

if ! command -v vegeta >/dev/null 2>&1; then
    warn "vegeta not installed."
    if command -v brew >/dev/null 2>&1; then
        log "Installing via brew"
        brew install vegeta
    elif command -v apt-get >/dev/null 2>&1; then
        # Try apt first (Debian sid has it; Ubuntu doesn't). Fall through to
        # binary install if apt can't find the package.
        log "Trying apt-get install vegeta..."
        $SUDO apt-get update -qq >/dev/null 2>&1 || true
        if $SUDO apt-get install -y vegeta 2>/dev/null; then
            log "vegeta installed via apt"
        else
            warn "vegeta not in apt repos, falling back to binary install"
            install_vegeta_binary
        fi
    else
        install_vegeta_binary
    fi
fi

# ----- Build the request body and target -----
TMPDIR=$(mktemp -d)
trap "rm -rf $TMPDIR" EXIT

cat > "$TMPDIR/event.json" <<EOF
{
  "api_key": "$TOKEN",
  "event": "loadtest_ping",
  "distinct_id": "loadtest_user",
  "properties": {
    "\$lib": "loadtest-capture",
    "loadtest_marker": true,
    "host": "$DOMAIN"
  },
  "timestamp": "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
}
EOF

cat > "$TMPDIR/targets.txt" <<EOF
POST https://$DOMAIN/capture/
Content-Type: application/json
@$TMPDIR/event.json
EOF

run_attack() {
    local rate="$1" duration="$2"
    log "Attacking $DOMAIN at $rate req/s for $duration"
    vegeta attack \
        -rate="$rate" \
        -duration="$duration" \
        -targets="$TMPDIR/targets.txt" \
        -timeout=30s \
        | tee "$TMPDIR/results-$rate.bin" \
        | vegeta report -type=text
    echo
}

# ----- Modes -----
case "$MODE" in
    constant)
        run_attack "$RATE" "$DURATION"
        ;;
    ramp)
        log "Running ramp: 100, 500, 1000, 5000, 10000 req/s × 30s each (cooldown 10s between)"
        log "Cancel anytime with Ctrl-C; vegeta finishes the current rate cleanly."
        for r in 100 500 1000 5000 10000; do
            log "=== ${r} req/s ==="
            run_attack "$r" "$DURATION"
            sleep 10
        done
        ;;
esac

ok "Done."
log "Watch ClickHouse ingestion in another terminal:"
echo "    docker compose exec clickhouse clickhouse-client --password=\"\$CLICKHOUSE_PASSWORD\" --query \\"
echo "      \"SELECT toStartOfMinute(timestamp) AS minute, count() AS events"
echo "       FROM posthog.events WHERE event = 'loadtest_ping' AND timestamp > now() - INTERVAL 10 MINUTE"
echo "       GROUP BY minute ORDER BY minute DESC\""
echo
log "Container resource usage:"
echo "    docker stats --no-stream"
echo
log "Kafka consumer lag (should stay near zero on a healthy stack):"
echo "    docker compose exec kafka rpk topic describe events_plugin_ingestion --brokers kafka:9092"
echo
log "Clean up test events when done:"
echo "    bin/loadtest-capture --cleanup"
