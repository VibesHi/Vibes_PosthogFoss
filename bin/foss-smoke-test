#!/usr/bin/env bash
#
# FOSS-fork smoke test entrypoint.
#
# Behaviour:
#   * Run from the host -- pipes the Python probe via stdin into the `web`
#     container so it works without rebuilding the container image after a
#     fresh `git pull` (which is the common case on prod).
#   * Run from inside any container that already has DJANGO_SETTINGS_MODULE
#     set -- exec the Python probe directly.
#
# Usage:
#   ./bin/foss-smoke-test
#
# Exit code 0 if all checks pass, 1 if any fail.

set -uo pipefail

cd "$(dirname "$0")/.."

PROBE="bin/foss_smoke_test.py"

if [ ! -f "$PROBE" ]; then
    echo "ERROR: $PROBE not found (cwd=$(pwd))" >&2
    exit 2
fi

# Inside container path: settings already wired, just execute.
if [ -f "/.dockerenv" ] || [ -n "${DJANGO_SETTINGS_MODULE:-}" ]; then
    exec python3 "$PROBE"
fi

# Host path: stream the probe over stdin so we don't depend on the file
# being baked into the image. -T disables TTY allocation so EOF propagates.
# DJANGO_SETTINGS_MODULE is set in docker-compose.prod.yml on the *app
# processes* (via Unit's preload), but `docker compose exec` spawns a fresh
# shell that inherits only the container's image-level env, so we re-set it
# here. cwd=/code so relative imports + manage.py-style apps load.
echo "Streaming smoke probe into web container..."
exec docker compose exec -T \
    -e DJANGO_SETTINGS_MODULE="${DJANGO_SETTINGS_MODULE:-posthog.settings}" \
    -w /code \
    web python3 - < "$PROBE"
