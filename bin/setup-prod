#!/usr/bin/env bash
#
# bin/setup-prod -- per-host bootstrap for self-hosted PostHog (production-ish).
#
# Idempotent. Safe to re-run after pulling new code.
#
# What it does:
#   1. Validates that .env exists and has no CHANGE_ME_* placeholders left.
#   2. Ensures compose/ runtime scripts (start, temporal-django-worker, wait) exist.
#   3. Downloads share/GeoLite2-City.mmdb if missing.
#   4. Builds and starts the stack via docker compose.
#
# Pre-reqs on the host:
#   - docker + docker compose v2
#   - curl, brotli (auto-installs brotli via apt if missing)
#   - openssl (only used by the user when filling in .env)
#

set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$REPO_ROOT"

log()  { printf '\033[1;34m[setup-prod]\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m[setup-prod]\033[0m %s\n' "$*" >&2; }
die()  { printf '\033[1;31m[setup-prod]\033[0m %s\n' "$*" >&2; exit 1; }

# Use sudo only if not running as root.
SUDO=""
[ "$(id -u)" -eq 0 ] || SUDO="sudo"

# ---------- 1. Validate .env ----------

[ -f .env ] || die ".env not found. Copy .env.example.prod to .env and fill it in:
    cp .env.example.prod .env
    \$EDITOR .env"

if grep -q '^[A-Z_]*=CHANGE_ME_' .env; then
    grep -n '^[A-Z_]*=CHANGE_ME_' .env >&2
    die ".env contains CHANGE_ME_ placeholders. Fill them in before running."
fi

# Source .env strictly to catch DOMAIN
set -a
# shellcheck disable=SC1091
source .env
set +a

[ -n "${DOMAIN:-}" ]                 || die ".env: DOMAIN is empty"
[ -n "${POSTHOG_SECRET:-}" ]         || die ".env: POSTHOG_SECRET is empty"
[ -n "${ENCRYPTION_SALT_KEYS:-}" ]   || die ".env: ENCRYPTION_SALT_KEYS is empty"
[ -n "${POSTHOG_DB_PASSWORD:-}" ]    || die ".env: POSTHOG_DB_PASSWORD is empty (run 'openssl rand -hex 24')"
[ -n "${OBJECT_STORAGE_PASSWORD:-}" ] || die ".env: OBJECT_STORAGE_PASSWORD is empty (run 'openssl rand -hex 24')"
[ -n "${CLICKHOUSE_PASSWORD:-}" ]    || die ".env: CLICKHOUSE_PASSWORD is empty (run 'openssl rand -hex 24')"

# Sanity: warn if password length looks short. The 24-byte (48 hex chars)
# convention is just a default; anything < 16 chars is suspicious.
for var in POSTHOG_DB_PASSWORD OBJECT_STORAGE_PASSWORD CLICKHOUSE_PASSWORD; do
    val="${!var}"
    if [ "${#val}" -lt 16 ]; then
        warn ".env: $var is shorter than 16 chars — consider regenerating with 'openssl rand -hex 24'"
    fi
done

log "Configured for DOMAIN=$DOMAIN"

# ---------- 2. compose/ runtime scripts ----------

mkdir -p compose

if [ ! -x compose/start ]; then
    log "Creating compose/start"
    cat > compose/start <<'EOF'
#!/bin/bash
./compose/wait
./bin/migrate
./bin/docker-server
EOF
    chmod +x compose/start
fi

if [ ! -x compose/temporal-django-worker ]; then
    log "Creating compose/temporal-django-worker"
    cat > compose/temporal-django-worker <<'EOF'
#!/bin/bash
./bin/temporal-django-worker
EOF
    chmod +x compose/temporal-django-worker
fi

if [ ! -x compose/wait ]; then
    log "Creating compose/wait"
    cat > compose/wait <<'EOF'
#!/usr/bin/env python3
import socket, time

def loop():
    print("Waiting for ClickHouse and Postgres to be ready")
    try:
        with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as s:
            s.connect(('clickhouse', 9000))
        print("Clickhouse is ready")
        with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as s:
            s.connect(('db', 5432))
        print("Postgres is ready")
    except ConnectionRefusedError:
        time.sleep(5)
        loop()

loop()
EOF
    chmod +x compose/wait
fi

# ---------- 3. GeoIP database ----------

mkdir -p share

if [ ! -f share/GeoLite2-City.mmdb ]; then
    log "Downloading GeoIP database"
    if ! command -v brotli >/dev/null 2>&1; then
        log "Installing brotli"
        $SUDO apt-get install -y --no-install-recommends brotli
    fi
    curl -L https://mmdbcdn.posthog.net/ --http1.1 \
        | brotli --decompress --output=share/GeoLite2-City.mmdb
    printf '{"date": "%s"}\n' "$(date +%Y-%m-%d)" > share/GeoLite2-City.json
    chmod 644 share/GeoLite2-City.mmdb share/GeoLite2-City.json
    log "GeoIP database ready"
else
    log "GeoIP database already present (skip)"
fi

# ---------- 4. Build + start ----------
# COMPOSE_FILE is read from .env, so no -f flag needed.

log "Building images (this can take 20-40 min on first run)"
$SUDO docker compose build

log "Starting stack"
$SUDO docker compose up -d

# ---------- 5. Runtime SQL tuning (idempotent) ----------
# Re-applies on every run so values self-heal if PostHog migrations ever
# overwrite them. Each block is best-effort: if CH isn't ready or the table
# doesn't exist yet (fresh install before migrations finish), skip and
# remind the user to re-run.

apply_log_entries_ttl() {
    local ttl_days="${POSTHOG_LOG_ENTRIES_TTL_DAYS:-14}"
    log "Applying log_entries TTL = $ttl_days days"
    $SUDO docker compose exec -T clickhouse clickhouse-client --query "
        ALTER TABLE posthog.sharded_log_entries
            MODIFY TTL toDate(timestamp) + INTERVAL $ttl_days DAY DELETE
            SETTINGS materialize_ttl_after_modify = 1
    " 2>/dev/null && log "  -> applied" \
                 || warn "  -> skipped (clickhouse not ready, or sharded_log_entries doesn't exist yet — re-run bin/setup-prod after first migrations finish)"
}

apply_query_log_archive_ttl() {
    local ttl_days="${POSTHOG_QUERY_LOG_ARCHIVE_TTL_DAYS:-30}"
    log "Applying query_log_archive TTL = $ttl_days days"
    $SUDO docker compose exec -T clickhouse clickhouse-client --query "
        ALTER TABLE posthog.sharded_query_log_archive
            MODIFY TTL toDate(event_date) + INTERVAL $ttl_days DAY DELETE
            SETTINGS materialize_ttl_after_modify = 1
    " 2>/dev/null && log "  -> applied" \
                 || warn "  -> skipped (clickhouse not ready, or sharded_query_log_archive doesn't exist yet — re-run bin/setup-prod after first migrations finish)"
}

apply_log_entries_ttl
apply_query_log_archive_ttl

log "Done. Tail logs with:"
log "    docker compose logs -f web worker"
