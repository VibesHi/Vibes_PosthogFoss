#!/usr/bin/env bash
#
# bin/setup-prod -- per-host bootstrap for self-hosted PostHog (production-ish).
#
# Idempotent. Safe to re-run after pulling new code. Phases are linear and
# fail-fast except where explicitly noted (TTL apply warns rather than dies so
# a flaky CH connection at the end doesn't waste the rest of the run).
#
# Required: docker + compose v2, curl, brotli (auto-installed on common
# distros), openssl (only used by the user when filling in .env).
#
# This file is the orchestrator. Phase implementations live in bin/lib/:
#
#   bin/lib/setup-prod-common.sh      log/warn/die, dc, ch_query, ch_wait_for, _source_env
#   bin/lib/setup-prod-env.sh         phase 1     validate + source .env
#   bin/lib/setup-prod-preflight.sh   phase 2/2b  host pre-flight + ee/ stub check
#   bin/lib/setup-prod-scaffold.sh    phase 3/3b/4 compose entrypoints, proto mirror, GeoIP
#   bin/lib/setup-prod-build.sh       phase 5/6   pull third-party + build local
#   bin/lib/setup-prod-migrations.sh  phase 7     async migrations check
#   bin/lib/setup-prod-runtime.sh     phase 8-11  compose up, CH wait, TTLs, backup soft-warn

set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$REPO_ROOT"

# shellcheck source=lib/setup-prod-common.sh
source bin/lib/setup-prod-common.sh
# shellcheck source=lib/setup-prod-env.sh
source bin/lib/setup-prod-env.sh
# shellcheck source=lib/setup-prod-preflight.sh
source bin/lib/setup-prod-preflight.sh
# shellcheck source=lib/setup-prod-scaffold.sh
source bin/lib/setup-prod-scaffold.sh
# shellcheck source=lib/setup-prod-build.sh
source bin/lib/setup-prod-build.sh
# shellcheck source=lib/setup-prod-migrations.sh
source bin/lib/setup-prod-migrations.sh
# shellcheck source=lib/setup-prod-runtime.sh
source bin/lib/setup-prod-runtime.sh

# ---------------------------------------------------------------------------
# Pipeline
# ---------------------------------------------------------------------------

phase_validate_env
phase_preflight
phase_check_ee_stubs
phase_compose_scripts
phase_sync_proto
phase_geoip
phase_pull
phase_build
phase_async_migrations_check
phase_compose_up

if ! phase_wait_clickhouse_ready; then
    warn "Stack is up but ClickHouse isn't authenticating — TTLs not applied."
    warn "Re-run 'bin/setup-prod' once 'docker compose ps' shows clickhouse healthy."
    exit 0
fi

ttl_failures=0
phase_apply_ttls || ttl_failures=$?

phase_check_backup_config

if [ "$ttl_failures" -eq 0 ]; then
    log "All phases complete. Tail logs with: docker compose logs -f web worker"
else
    warn "Done with $ttl_failures TTL apply failure(s). Re-run setup-prod after fixing."
    exit 1
fi
