#!/usr/bin/env python3
"""Symbol-level coverage check for the FOSS ee/ stub package.

The bash scan in bin/setup-prod only verifies that ee/X/Y.py *exists* for every
`from ee.X.Y import Z` in production code. It can't tell whether Z is actually
defined in the file. Django boot will then crash with ImportError at the first
missing symbol, requiring a docker rebuild round-trip per fix.

This script does the symbol-level check via AST without importing anything:

  1. grep every `from ee.X.Y import a, b, c` line in posthog/ + products/
  2. parse ee/X/Y.py with ast and collect top-level names
     (def, class, =, import-as, dataclass-decorated etc.)
  3. flag every (a, b, c) not present in the parsed names

Run before each docker build:
    bin/check-ee-stub-symbols

Exit code 0 => all good. Exit code 1 => missing symbols, see output.
"""
from __future__ import annotations

import ast
import os
import re
import subprocess
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
EE = ROOT / "ee"

# Match `from ee.X.Y import a, b as c, d` even with line continuations
# (we slurp parenthesized multi-line forms post-grep with a small parser below).
FROM_IMPORT_HEAD = re.compile(r"^\s*from\s+ee\.([A-Za-z0-9_.]+)\s+import\s+(.+?)\s*$")


def collect_module_names(path: Path) -> set[str]:
    """All top-level names defined in `path`. Empty set if file unparseable."""
    try:
        tree = ast.parse(path.read_text(), filename=str(path))
    except SyntaxError:
        return set()
    names: set[str] = set()
    for node in tree.body:
        if isinstance(node, ast.FunctionDef | ast.AsyncFunctionDef | ast.ClassDef):
            names.add(node.name)
        elif isinstance(node, ast.Assign):
            for tgt in node.targets:
                if isinstance(tgt, ast.Name):
                    names.add(tgt.id)
        elif isinstance(node, ast.AnnAssign) and isinstance(node.target, ast.Name):
            names.add(node.target.id)
        elif isinstance(node, ast.Import):
            for a in node.names:
                names.add(a.asname or a.name.split(".")[0])
        elif isinstance(node, ast.ImportFrom):
            for a in node.names:
                if a.name == "*":
                    continue
                names.add(a.asname or a.name)
    return names


def discover_ee_imports() -> list[tuple[str, str, str, list[str]]]:
    """Walk posthog/ + products/ source files and AST-parse every
    `from ee.X import a, b, c` (top-level OR nested inside functions /
    try-blocks) into structured records.

    AST-based so we correctly handle parenthesised multi-line imports like:

        from ee.hogai.session_summaries.utils import (
            calculate_time_since_start,
            get_column_index,
            unpack_full_event_id,
        )

    The previous grep-based implementation only saw the first physical line
    and parsed an empty symbol list, silently missing every name in the
    body of multi-line imports.

    Returns [(file_relative, ee_module, line_number, [imported_names])].
    """
    out: list[tuple[str, str, str, list[str]]] = []
    for src in list(ROOT.glob("posthog/**/*.py")) + list(ROOT.glob("products/**/*.py")):
        rel = src.relative_to(ROOT)
        # Mirror the bash scan's exclude rules.
        if "test" in rel.parts or rel.name.startswith("test_") or rel.name == "conftest.py":
            continue
        try:
            tree = ast.parse(src.read_text(), filename=str(src))
        except SyntaxError:
            continue
        for node in ast.walk(tree):
            if not isinstance(node, ast.ImportFrom):
                continue
            if not node.module or not node.module.startswith("ee."):
                continue
            ee_mod = node.module[len("ee.") :]
            names = [a.name for a in node.names if a.name != "*"]
            if not names:
                continue
            out.append((str(rel), ee_mod, str(node.lineno), names))
    return out


def parse_imported_names(s: str) -> list[str]:
    """`a, b as c, (d, e)` → ['a', 'c', 'd', 'e']."""
    # Strip trailing inline comments like `# noqa: F403` so they don't show up
    # as fake imports.
    if "#" in s:
        s = s.split("#", 1)[0]
    s = s.strip().lstrip("(").rstrip(")")
    out: list[str] = []
    for part in s.split(","):
        part = part.strip()
        if not part:
            continue
        if " as " in part:
            part = part.split(" as ", 1)[1].strip()
        # Handle `name)` if grep cut a multi-line import mid-list
        part = part.rstrip(")").strip()
        if part.isidentifier():
            out.append(part)
    return out


def resolve_module_file(mod: str) -> Path | None:
    base = EE / mod.replace(".", "/")
    if (base.with_suffix(".py")).is_file():
        return base.with_suffix(".py")
    if (base / "__init__.py").is_file():
        return base / "__init__.py"
    return None


def collect_class_attrs(path: Path) -> dict[str, set[str]]:
    """For each top-level class in `path`, return the set of class-attribute
    names defined directly in its body (not inherited).

    Used to verify `EnumName.MEMBER` references at IMPORT time in OSS code.
    """
    try:
        tree = ast.parse(path.read_text(), filename=str(path))
    except SyntaxError:
        return {}
    out: dict[str, set[str]] = {}
    for node in tree.body:
        if not isinstance(node, ast.ClassDef):
            continue
        attrs: set[str] = set()
        for stmt in node.body:
            if isinstance(stmt, ast.Assign):
                for tgt in stmt.targets:
                    if isinstance(tgt, ast.Name):
                        attrs.add(tgt.id)
            elif isinstance(stmt, ast.AnnAssign) and isinstance(stmt.target, ast.Name):
                attrs.add(stmt.target.id)
            elif isinstance(stmt, ast.FunctionDef | ast.AsyncFunctionDef):
                attrs.add(stmt.name)
        # Track whether a permissive metaclass is in play (PermissiveConstants
        # base or _PermissiveConstantsMeta metaclass) -- accept any attribute.
        bases = [ast.unparse(b) for b in node.bases]
        meta_kw = next((k for k in node.keywords if k.arg == "metaclass"), None)
        meta_name = ast.unparse(meta_kw.value) if meta_kw else ""
        if any("PermissiveConstants" in b for b in bases) or "PermissiveConstants" in meta_name:
            attrs.add("__permissive__")
        out[node.name] = attrs
    return out


def find_module_level_attr_access(path: Path, imports: dict[str, tuple[str, str]]) -> list[tuple[str, str, str]]:
    """Walks `path`'s module-level statements (not function bodies) looking for
    `Imported.X` attribute access where `Imported` was imported from `ee.*`.

    Returns [(file, ee_module, attr)].
    """
    try:
        tree = ast.parse(path.read_text(), filename=str(path))
    except SyntaxError:
        return []
    found: list[tuple[str, str, str]] = []

    def is_module_level(stmt) -> bool:
        # We want class body, dataclass field defaults, decorators, top-level
        # assignments. Function bodies are NOT module-level (they fire at call
        # time, not import time).
        return True

    def walk(node: ast.AST):
        for child in ast.walk(node):
            if isinstance(child, ast.Attribute) and isinstance(child.value, ast.Name):
                base = child.value.id
                if base in imports:
                    found.append((str(path), imports[base][0], child.attr))

    for stmt in tree.body:
        if isinstance(stmt, ast.FunctionDef | ast.AsyncFunctionDef):
            # Inspect decorators + default arg values, but not the body itself.
            for d in stmt.decorator_list:
                walk(d)
            for default in stmt.args.defaults + stmt.args.kw_defaults:
                if default is not None:
                    walk(default)
            continue
        if isinstance(stmt, ast.ClassDef):
            # Decorators, base list, and class-body statements that aren't
            # method definitions all evaluate at class-creation time.
            for d in stmt.decorator_list:
                walk(d)
            for b in stmt.bases:
                walk(b)
            for body_stmt in stmt.body:
                if isinstance(body_stmt, ast.FunctionDef | ast.AsyncFunctionDef):
                    for d in body_stmt.decorator_list:
                        walk(d)
                    for default in body_stmt.args.defaults + body_stmt.args.kw_defaults:
                        if default is not None:
                            walk(default)
                else:
                    walk(body_stmt)
            continue
        walk(stmt)
    return found


def collect_imports(path: Path) -> dict[str, tuple[str, str]]:
    """`{local_name: (ee_module, original_name)}` for `from ee.X import Y [as Z]` lines."""
    try:
        tree = ast.parse(path.read_text(), filename=str(path))
    except SyntaxError:
        return {}
    out: dict[str, tuple[str, str]] = {}
    for node in tree.body:
        if not isinstance(node, ast.ImportFrom):
            continue
        if not node.module or not node.module.startswith("ee."):
            continue
        ee_mod = node.module[len("ee.") :]
        for a in node.names:
            local = a.asname or a.name
            out[local] = (ee_mod, a.name)
    return out


def main() -> int:
    issues: list[str] = []
    cache: dict[Path, set[str]] = {}
    cls_cache: dict[Path, dict[str, set[str]]] = {}
    # Pass 1: file + symbol existence via AST (correctly handles multi-line
    # parenthesised `from ee.X import (a, b, c)` forms).
    for file, mod, lineno, names in discover_ee_imports():
        path = resolve_module_file(mod)
        if path is None:
            issues.append(
                f"{file}:{lineno}: missing FILE  ee/{mod.replace('.', '/')}{{.py,/__init__.py}}"
            )
            continue
        defined = cache.setdefault(path, collect_module_names(path))
        for sym in names:
            if sym not in defined:
                issues.append(
                    f"{file}:{lineno}: missing SYMBOL  ee.{mod}.{sym}  "
                    f"(add to {path.relative_to(ROOT)})"
                )
    # Pass 2: module-level `Imported.X` attribute access. Catches the
    # `AssistantMode.ASSISTANT` class-body-default class of failure that
    # crashes Django boot before any function runs.
    for src in list(ROOT.glob("posthog/**/*.py")) + list(ROOT.glob("products/**/*.py")):
        rel = src.relative_to(ROOT)
        if "test" in rel.parts or rel.name.startswith("test_") or rel.name == "conftest.py":
            continue
        imports = collect_imports(src)
        if not imports:
            continue
        for _f, ee_mod, attr in find_module_level_attr_access(src, imports):
            ee_path = resolve_module_file(ee_mod)
            if ee_path is None:
                continue  # already flagged in pass 1
            # We need to look up the LOCALLY-IMPORTED NAME on the ee module's
            # class. If `from ee.X import Foo`, and code does `Foo.BAR`, find
            # the class `Foo` in ee/X.py and check it has BAR.
            local_name_to_orig = {loc: orig for loc, (mod, orig) in imports.items() if mod == ee_mod}
            # imports dict keys are local names; we got `attr` via base.id matching local name.
            # Find which local name was the base. Easier: re-walk.
            pass  # (fall through; specific checks below)
        # Per-class member check.
        for base_local, (ee_mod, ee_orig) in imports.items():
            ee_path = resolve_module_file(ee_mod)
            if ee_path is None:
                continue
            class_attrs = cls_cache.setdefault(ee_path, collect_class_attrs(ee_path))
            target_attrs = class_attrs.get(ee_orig)
            if target_attrs is None:
                continue
            if "__permissive__" in target_attrs:
                continue
            # Skip attributes Django auto-injects on model classes / managers,
            # and DRF auto-exposes on serializers/viewsets.
            DJANGO_AUTO = {
                "objects", "_meta", "_default_manager", "_base_manager",
                "DoesNotExist", "MultipleObjectsReturned", "pk", "id",
                "Meta", "save", "delete",
            }
            for _f, _mod, attr in find_module_level_attr_access(src, {base_local: (ee_mod, ee_orig)}):
                if attr.startswith("_"):
                    continue
                if attr in target_attrs:
                    continue
                if attr in DJANGO_AUTO:
                    continue
                issues.append(
                    f"{rel}: missing MEMBER  ee.{ee_mod}.{ee_orig}.{attr}  "
                    f"(add to {ee_path.relative_to(ROOT)} or inherit from PermissiveConstants)"
                )
    if issues:
        print("EE stub symbol coverage gaps:")
        for s in sorted(set(issues)):
            print(f"  {s}")
        print(f"\n{len(set(issues))} issue(s). Add the missing symbols and rerun.")
        return 1
    print("ee/ stub symbol coverage looks complete")
    return 0


if __name__ == "__main__":
    sys.exit(main())
